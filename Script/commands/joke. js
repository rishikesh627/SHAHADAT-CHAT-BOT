          body: `╭─❖ 𝐉𝐎𝐊𝐄 𝐓𝐈𝐌𝐄 ❖─╮\n${randomJoke}\n╰───────────────╯\n😂 𝐄𝐧𝐣𝐨𝐲! 😂`,
          attachment: fs.createReadStream(imgPath)
        },
        threadID,
        () => {
          if (fs.existsSync(imgPath)) fs.unlinkSync(imgPath);
        },
        messageID
      );
    };

    request(encodeURI(imgLink))
      .pipe(fs.createWriteStream(imgPath))
      .on("close", callback)
      .on("error", () => {
        api.sendMessage(randomJoke, threadID, messageID);
      });

  } catch (error) {
    console.error("[JOKE ERROR]", error);
    api.sendMessage(
      "❌ Joke load karne mein error aaya! Try again.",
      threadID,
      messageID
    );
  }
};